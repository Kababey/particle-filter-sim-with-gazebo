<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="ar_room">
    <physics name="default" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.85 0.88 0.92 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>
    <light type="point" name="lamp">
      <pose>4.00 3.00 2.00 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <attenuation><range>30</range><linear>0.05</linear></attenuation>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <!-- centered under the room so the floor spans the whole room + margin -->
        <pose>4.000 3.000 0 0 0 0</pose>
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>12.0 10.0</size></plane></geometry>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>12.0 10.0</size></plane></geometry>
          <material>
            <ambient>0.3 0.3 0.33 1</ambient>
            <diffuse>0.35 0.35 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <link name="link">
        <pose>4.0000 0.0000 0.7500 0 0 0</pose>
        <collision name="c"><geometry><box><size>8.2000 0.1000 1.5000</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>8.2000 0.1000 1.5000</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.82 1</ambient>
            <diffuse>0.8 0.8 0.82 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static>
      <link name="link">
        <pose>4.0000 6.0000 0.7500 0 0 0</pose>
        <collision name="c"><geometry><box><size>8.2000 0.1000 1.5000</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>8.2000 0.1000 1.5000</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.82 1</ambient>
            <diffuse>0.8 0.8 0.82 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <link name="link">
        <pose>0.0000 3.0000 0.7500 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1000 6.0000 1.5000</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.1000 6.0000 1.5000</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.82 1</ambient>
            <diffuse>0.8 0.8 0.82 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <link name="link">
        <pose>8.0000 3.0000 0.7500 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1000 6.0000 1.5000</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.1000 6.0000 1.5000</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.82 1</ambient>
            <diffuse>0.8 0.8 0.82 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://apriltag_marker</uri>
      <name>ar_tag_0</name>
      <pose>0.8300 0.0600 0.5500 0 0 1.570796</pose>
    </include>
    <include>
      <uri>model://apriltag_marker</uri>
      <name>ar_tag_1</name>
      <pose>7.1300 0.0600 0.5500 0 0 1.570796</pose>
    </include>
    <include>
      <uri>model://apriltag_marker</uri>
      <name>ar_tag_2</name>
      <pose>0.7000 5.9400 0.5500 0 0 -1.570796</pose>
    </include>
    <include>
      <uri>model://apriltag_marker</uri>
      <name>ar_tag_3</name>
      <pose>1.9300 5.9400 0.5500 0 0 -1.570796</pose>
    </include>
    <include>
      <uri>model://apriltag_marker</uri>
      <name>ar_tag_4</name>
      <pose>0.0600 1.3800 0.5500 0 0 0.000000</pose>
    </include>
    <include>
      <uri>model://apriltag_marker</uri>
      <name>ar_tag_5</name>
      <pose>0.0600 4.8600 0.5500 0 0 0.000000</pose>
    </include>
    <include>
      <uri>model://apriltag_marker</uri>
      <name>ar_tag_6</name>
      <pose>7.9400 1.6600 0.5500 0 0 3.141593</pose>
    </include>
    <include>
      <uri>model://apriltag_marker</uri>
      <name>ar_tag_7</name>
      <pose>7.9400 5.0100 0.5500 0 0 3.141593</pose>
    </include>
  </world>
</sdf>
