<?xml version="1.0" ?>
<!-- Regenerated by generate_world.py so size/texture match config/tag_map.yaml.
     The +X face carries the tag. -->
<sdf version="1.10">
  <model name="apriltag_marker">
    <static>true</static>
    <link name="link">
      <visual name="tag">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box><size>0.02 0.480 0.480</size></box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/tag36h11_0.png</albedo_map>
              <emissive_map>materials/textures/tag36h11_0.png</emissive_map>
              <metalness>0.0</metalness>
              <roughness>0.95</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
